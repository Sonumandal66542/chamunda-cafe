rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    function isOwner() {
      return request.auth != null;
    }

    function tableDoc(t) {
      return /databases/$(database)/documents/tables/$(t);
    }

    // A new order must be sensible, and its phone must hold the table (or claim it in the same save).
    function validNewOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['table', 'kind', 'name', 'phone', 'items', 'note', 'total', 'status', 'createdAt', 'device', 'key'])
        && d.status == 'new'
        && d.table is int && d.table >= 1 && d.table <= 8
        && d.kind in ['guest', 'customer']
        && d.name is string && d.name.size() <= 60
        && d.phone is string && d.phone.matches('^9[0-9]{9}$')
        && d.note is string && d.note.size() <= 200
        && d.items is list && d.items.size() > 0 && d.items.size() <= 30
        && d.total is number && d.total > 0 && d.total <= 100000
        && d.createdAt is number
        && d.createdAt > request.time.toMillis() - 86400000
        && d.createdAt < request.time.toMillis() + 86400000
        && d.key is string && d.key.size() >= 20 && d.key.size() <= 64
        && d.device is string && d.device == hashing.sha256(d.key).toHexString()
        && getAfter(tableDoc(string(d.table))).data.holder == d.device
        && getAfter(/databases/$(database)/documents/devices/$(d.device)).data.table == d.table
        && getAfter(/databases/$(database)/documents/phones/$(d.phone)).data.table == d.table;
    }

    // An earlier table is "finished" once nobody (or someone else) holds it any more.
    function tableFinished(t, who) {
      return !exists(tableDoc(string(t))) || get(tableDoc(string(t))).data.holder != who;
    }

    // One open table per phone.
    function validDeviceSeat(dev) {
      let nd = request.resource.data;
      let o = getAfter(/databases/$(database)/documents/orders/$(nd.lastOrder)).data;
      return nd.keys().hasOnly(['table', 'since', 'lastOrder'])
        && nd.table is int && nd.since is number && nd.lastOrder is string
        && o.device == dev && o.table == nd.table
        && (resource == null || resource.data.table == nd.table || tableFinished(resource.data.table, dev));
    }

    // One open table per mobile number.
    function validPhoneSeat(ph) {
      let nd = request.resource.data;
      let o = getAfter(/databases/$(database)/documents/orders/$(nd.lastOrder)).data;
      return nd.keys().hasOnly(['table', 'device', 'since', 'lastOrder'])
        && nd.table is int && nd.device is string && nd.since is number && nd.lastOrder is string
        && o.phone == ph && o.device == nd.device && o.table == nd.table
        && (resource == null || resource.data.table == nd.table || tableFinished(resource.data.table, resource.data.device));
    }

    // A phone can take a table only if it's free (or already theirs), and only together with an order for it.
    function validClaim(t) {
      let nd = request.resource.data;
      let o = getAfter(/databases/$(database)/documents/orders/$(nd.lastOrder)).data;
      return nd.keys().hasOnly(['holder', 'since', 'lastOrder'])
        && nd.holder is string && nd.holder.size() == 64
        && nd.lastOrder is string && nd.lastOrder.size() > 0
        && nd.since is number
        && o.device == nd.holder
        && o.table == int(t)
        && (resource == null || resource.data.holder == '' || resource.data.holder == nd.holder);
    }

    match /orders/{orderId} {
      allow get: if true;
      allow create: if validNewOrder();
      allow list, update, delete: if isOwner();
    }

    match /tables/{t} {
      allow read: if true;
      allow write: if isOwner();
      allow create, update: if validClaim(t);
    }

    match /devices/{dev} {
      allow write: if isOwner();
      allow create, update: if validDeviceSeat(dev);
    }

    match /phones/{ph} {
      allow write: if isOwner();
      allow create, update: if validPhoneSeat(ph);
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /kitchen/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
