rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders: anyone can place one and track their own (by its secret id).
    // Only the logged-in Kitchen Boss can see the list, update or delete.
    match /orders/{orderId} {
      allow get: if true;
      allow list, update, delete: if request.auth != null;
      allow create: if
        request.resource.data.keys().hasOnly(['table', 'kind', 'name', 'phone', 'items', 'note', 'total', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.table is int
        && request.resource.data.table >= 1 && request.resource.data.table <= 8
        && request.resource.data.kind in ['guest', 'customer']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 15
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.createdAt is number;
    }

    // Sold-out switches: everyone reads, only the Kitchen Boss changes.
    match /kitchen/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
